# Copy this file to `.env` and fill in your own values.
# `.env` is listed in .gitignore and must never be committed.
#
# Nothing before Chapter 20 needs this file. The book trains its own models on your
# laptop: no GPU, no cloud account and no API key.

# Determinism. The book's output was produced with these values; change them and the
# fourth decimal place of a result may move. Chapter 15 explains why.
# FORESIGHT_SEED=20260201
# FORESIGHT_THREADS=1

# --- Optional: Chapter 20 only ---------------------------------------------------------
# Chapter 20 compares a trained ticket classifier with a prompted language model on
# accuracy, latency and cost per 1,000 tickets. That comparison needs a key; every other
# listing in the book runs without one, and so does the rest of Chapter 20.
# OPENAI_API_KEY=

# Safety rail for that comparison: refuse to run it if one pass would cost more than
# this many US dollars.
BOOK_SPEND_CEILING_USD=2.00

# Token prices, in US dollars per million tokens, from the provider's pricing page. Left
# blank on purpose: the runner reports token counts either way, and reports dollars only
# once you have supplied rates you have checked. Appendix C says where to find them.
# RATE_<MODEL>_INPUT=
# RATE_<MODEL>_OUTPUT=
